# Application
APP_NAME=LLM Model Evaluator
DEBUG=false
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3002

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llm_evaluator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=llm_evaluator

# Redis & RabbitMQ
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# LLM providers — set at least one (OpenAI recommended for this setup)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
HUGGINGFACE_API_TOKEN=
OPENAI_MODEL=gpt-4o-mini

# Timeouts
LLM_TIMEOUT_SECONDS=90
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# Job persistence: postgres (Docker) or memory (local unit tests)
JOB_STORE=postgres
USE_CELERY=false

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8002
